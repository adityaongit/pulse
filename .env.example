# Data source. false: deterministic demo data in data/demo.db. true: Google Health API into data/pulse.db.
GOOGLE_OAUTH_ENABLED=false
# DATABASE_PATH=data/demo.db
# PORT=3000

# Profile (required)
BIRTH_DATE=1990-01-01
SEX=male
TZ=Asia/Kolkata
# MAX_HR=185   # default: Tanaka, 208 - 0.7 * age
# HEIGHT_CM=178   # optional; Healthspan leaves out lean body mass without it

# Google OAuth (required when GOOGLE_OAUTH_ENABLED=true). Redirect URI is APP_URL/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Cloudflare Access (required unless DEV_ACCESS_BYPASS=1).
# CF_ACCESS_TEAM_DOMAIN is https://<team>.cloudflareaccess.com; CF_ACCESS_AUD is the application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Skips the Access check. Only accepted under `next dev` (NODE_ENV=development); startup fails otherwise.
DEV_ACCESS_BYPASS=1
