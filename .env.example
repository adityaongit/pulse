# Data source. false: deterministic demo data in data/demo.db. true: Google Health API into data/pulse.db.
GOOGLE_OAUTH_ENABLED=false
# DATABASE_PATH=data/demo.db
# PORT=3000
TZ=Asia/Kolkata

# Google OAuth (required when GOOGLE_OAUTH_ENABLED=true). It is also the sign-in: "Sign in with Google".
# Authorized redirect URI: <the URL you open Pulse on>/oauth/callback, e.g. http://localhost:3000/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed in. Unset: the first account to sign in claims this instance.
# Set it on anything reachable from the internet.
# OWNER_EMAIL=you@gmail.com
# Pins the OAuth redirect host (behind a proxy or tunnel). Unset: the host the request came in on.
# APP_URL=https://pulse.example.com

# Your birth date, sex, height and max HR are asked at first sign-in (onboarding) and live in the
# database; edit them in Settings > Profile.

# Optional: the Home avatar photo, an absolute URL or a path under public/ ("/me.jpg").
# Without it, public/avatar.jpg, .png or .webp is used when present, else the outlined icon.
# AVATAR_URL=
