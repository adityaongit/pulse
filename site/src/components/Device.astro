---
// An app screen in a device frame drawn in CSS: the app's own markup (src/kit/screens, `pnpm screens`), laid out at
// the size it was captured at (390 or 1440 wide) and scaled to the frame, so text and charts stay sharp at any size
// and pixel density. The screen is a picture: inert, out of the accessibility tree, described by its label.
// `part` draws a captured piece (a dial) with no frame. `crop` draws a band of a screen (from y, that tall, in the
// capture's own pixels) with no frame either: one real card of the app, for the feature tiles.
import "../kit/kit.css"
import { screen } from "../lib/screens"
import type { Part } from "../lib/screens"
import type { Shot } from "../data/metrics"

interface Props {
  shot: Shot | Part
  class?: string
  /** Overrides the screen's description. */
  label?: string
  /** [top, height] of the band to show, in the capture's pixels. */
  crop?: [number, number]
}
const { shot, class: className, label, crop } = Astro.props
const { html, width, height, alt, top } = screen(shot)
const kind = crop ? "crop" : shot.startsWith("phone") ? "phone" : shot.startsWith("laptop") ? "laptop" : "part"
// The phone's status bar is part of the frame (the capture starts below it), 50 of its 844 points.
const status = kind === "phone" ? 50 : 0
const box = crop
  ? `aspect-ratio:${width} / ${crop[1]};--w:${width}px;--top:${crop[0]}px`
  : `aspect-ratio:${width} / ${height + status};--w:${width}px${top ? `;background:${top}` : ""}`
const decorative = kind === "part" || kind === "crop"
---

<div
  class:list={["device", `device-${kind}`, className]}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : (label ?? alt)}
  aria-hidden={decorative ? "true" : undefined}
  data-nosnippet
>
  <div class="shell">
    <div class="screen" style={box}>
      <div class="canvas" inert>
        {
          kind === "phone" && (
            <div class="status" aria-hidden="true">
              <span>9:41</span>
              <span class="island" />
              <span class="bars">
                <svg width="18" height="12" viewBox="0 0 18 12" fill="#fff">
                  <rect x="0" y="8" width="3" height="4" rx="1" />
                  <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
                  <rect x="10" y="3" width="3" height="9" rx="1" />
                  <rect x="15" y="0" width="3" height="12" rx="1" />
                </svg>
                <svg width="27" height="13" viewBox="0 0 27 13">
                  <rect x=".5" y=".5" width="23" height="12" rx="3.5" fill="none" stroke="#fff" stroke-opacity=".4" />
                  <rect x="2" y="2" width="17" height="9" rx="2" fill="#fff" />
                  <rect x="25" y="4.5" width="1.5" height="4" rx=".75" fill="#fff" fill-opacity=".4" />
                </svg>
              </span>
            </div>
          )
        }
        <Fragment set:html={html} />
      </div>
    </div>
  </div>
  {kind === "laptop" && <div class="base" aria-hidden="true" />}
</div>

<style>
  /* Every length of a frame is in cqw of the device, so the frame keeps its proportions at any width. */
  .device {
    container-type: inline-size;
  }
  .screen {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    background: var(--background-top);
    /* Off screen, the browser skips laying out and painting the app's markup; the box keeps its size. */
    content-visibility: auto;
  }
  /* The captured layout at its own width, scaled to the screen: 100cqw / --w, as a unitless ratio. */
  .canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--w);
    scale: tan(atan2(100cqw, var(--w)));
    transform-origin: 0 0;
    user-select: none;
  }

  /* Phone: a 10/390 bezel, screen corners of 55/390 and the outer corner concentric with them. */
  .device-phone .shell {
    padding: 2.6cqw;
    border-radius: 16.4cqw;
    background: linear-gradient(160deg, #3d454b, #1b1f23 38%, #262c31 70%, #33393f);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.16),
      inset 0 0 0 0.9cqw #0b0d0f,
      0 2px 4px rgb(0 0 0 / 0.3),
      0 28px 56px -14px rgb(0 0 0 / 0.6);
  }
  .device-phone .screen {
    border-radius: 13.8cqw;
  }
  .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 50px;
    padding: 6px 30px 0 44px;
    color: #fff;
    font: 600 15px/1 -apple-system, system-ui, var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 120px;
    height: 34px;
    translate: -50% 0;
    border-radius: 20px;
    background: #000;
  }
  .bars {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  /* Laptop: a thin black bezel in a lid, then the base, a little wider, with its finger notch. */
  .device-laptop .shell {
    position: relative;
    margin-inline: 5.5%;
    padding: 1.7cqw 1.7cqw 2.3cqw;
    border-radius: 2.6cqw 2.6cqw 0.9cqw 0.9cqw;
    background: #0b0d0f;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      inset 0 0 0 0.35cqw #1a1e21,
      0 30px 70px -24px rgb(0 0 0 / 0.7);
  }
  /* The camera. */
  .device-laptop .shell::before {
    content: "";
    position: absolute;
    top: 0.65cqw;
    left: 50%;
    width: 0.5cqw;
    height: 0.5cqw;
    translate: -50% 0;
    border-radius: 50%;
    background: #22282c;
  }
  .device-laptop .screen {
    border-radius: 0.5cqw;
  }
  .base {
    position: relative;
    height: 2.2cqw;
    border-radius: 0 0 3cqw 3cqw / 0 0 1.8cqw 1.8cqw;
    background: linear-gradient(180deg, #4a5258 0, #2b3136 35%, #171b1e 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 18px 30px -12px rgb(0 0 0 / 0.6);
  }
  .base::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 15%;
    height: 42%;
    translate: -50% 0;
    border-radius: 0 0 0.9cqw 0.9cqw;
    background: linear-gradient(180deg, #1a1e21, #2a3034);
  }

  .device-part .screen {
    background: none;
    content-visibility: visible;
  }
  .device-crop .screen {
    background: none;
  }
  .device-crop .canvas {
    top: calc(var(--top) * -1 * tan(atan2(100cqw, var(--w))));
  }
</style>
