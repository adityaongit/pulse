   if (text === undefined || text === null || Global.isSsr) {
@@ -74,7 +103,7 @@ export var getStringSize = function getStringSize(text) {
 
   // If caching is disabled, measure directly
   if (!currentConfig.enableCache) {
-    return measureTextWithDOM(text, style);
+    return measureTextWithCanvas(text, style);
   }
   var cacheKey = createCacheKey(text, style);
   var cachedResult = stringCache.get(cacheKey);
@@ -83,7 +112,7 @@ export var getStringSize = function getStringSize(text) {
