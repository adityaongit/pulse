+
+// Pulse patch: measure on a canvas instead of a span in <body>. The span forced a synchronous style recalculation of
+// the whole document on every new label while React was still committing the charts (about 80 forced reflows,
+// 1.9 s of a 2.5 s hydration task on a phone). The canvas uses the same font the span inherited (body), with the
+// style overrides recharts passes, so the numbers match the old measurement.
+var canvasCtx = null;
+var bodyFont = null;
+var measureTextWithCanvas = (text, style) => {
+  try {
+    if (!canvasCtx) canvasCtx = document.createElement("canvas").getContext("2d");
+    if (!canvasCtx) return measureTextWithDOM(text, style);
+    if (!bodyFont) {
+      var cs = getComputedStyle(document.body);
+      bodyFont = { fontStyle: cs.fontStyle, fontWeight: cs.fontWeight, fontSize: cs.fontSize, fontFamily: cs.fontFamily };
+    }
+    var fontSize = style.fontSize || bodyFont.fontSize;
+    if (typeof fontSize === "number") fontSize = fontSize + "px";
+    canvasCtx.font = [style.fontStyle || bodyFont.fontStyle, style.fontWeight || bodyFont.fontWeight, fontSize, style.fontFamily || bodyFont.fontFamily].join(" ");
+    if ("letterSpacing" in canvasCtx) canvasCtx.letterSpacing = style.letterSpacing ? String(style.letterSpacing) : "0px";
+    var s = String(text);
+    if (style.textTransform === "uppercase") s = s.toUpperCase();
+    else if (style.textTransform === "lowercase") s = s.toLowerCase();
+    var m = canvasCtx.measureText(s);
+    var height = (m.fontBoundingBoxAscent || 0) + (m.fontBoundingBoxDescent || 0) || parseFloat(fontSize) * 1.2;
+    return { width: m.width, height: height };
+  } catch (_unused) {
+    return measureTextWithDOM(text, style);
+  }
+};
